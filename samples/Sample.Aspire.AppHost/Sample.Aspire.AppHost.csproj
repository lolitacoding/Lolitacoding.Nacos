<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.5" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- The sample uses the dashboard and DCP packages rather than the Aspire CLI bundle, which the
         SDK reports as ASPIRE010. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The library is not an orchestrated resource, so it is a plain compile reference. -->
    <ProjectReference Include="..\..\src\Lolitacoding.Aspire.Hosting.Nacos\Lolitacoding.Aspire.Hosting.Nacos.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Sample.AspNetCore\Sample.AspNetCore.csproj" IsAspireProjectResource="true" />
  </ItemGroup>

</Project>
