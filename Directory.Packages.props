<Project>

  <PropertyGroup>
    <!-- Central package version management: .csproj files never carry versions. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build, analyzers and versioning">
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>

  <ItemGroup Label="Protocol and transport">
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Service discovery integration">
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire integration">
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
  </ItemGroup>

  <ItemGroup Label="Optional configuration parsers">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Transitive dependencies pinned past a security advisory">
    <!-- Aspire.Hosting brings in StreamJsonRpc, which resolves MessagePack, and NuGet's audit reports
         some of those releases as vulnerable (GHSA-qhrr-8q5h-9q3h). Aspire 13.6.5 requires 2.5.307
         or later, so the pin tracks that floor; central transitive pinning is what lifts it into
         every project that would otherwise have resolved the flagged one. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

</Project>
