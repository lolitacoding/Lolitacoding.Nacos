<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lolitacoding.Nacos.Extensions.ServiceDiscovery</RootNamespace>
    <AssemblyName>Lolitacoding.Nacos.Extensions.ServiceDiscovery</AssemblyName>
    <PackageId>Lolitacoding.Nacos.Extensions.ServiceDiscovery</PackageId>
    <Description>Microsoft.Extensions.ServiceDiscovery integration for Lolitacoding.Nacos: resolve service endpoints from the Nacos registry.</Description>
    <!-- The ServiceDiscovery package consumes configuration and reflection-heavy options binding;
         the library itself makes no assumptions about trimming. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lolitacoding.Nacos\Lolitacoding.Nacos.csproj" />
    <ProjectReference Include="..\Lolitacoding.Nacos.Extensions.DependencyInjection\Lolitacoding.Nacos.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Primitives" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lolitacoding.Nacos.Tests" />
    <InternalsVisibleTo Include="Lolitacoding.Nacos.IntegrationTests" />
  </ItemGroup>

</Project>
