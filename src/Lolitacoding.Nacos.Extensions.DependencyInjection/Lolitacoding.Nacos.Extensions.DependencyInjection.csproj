<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lolitacoding.Nacos.Extensions.DependencyInjection</RootNamespace>
    <AssemblyName>Lolitacoding.Nacos.Extensions.DependencyInjection</AssemblyName>
    <PackageId>Lolitacoding.Nacos.Extensions.DependencyInjection</PackageId>
    <Description>Dependency injection extensions for Lolitacoding.Nacos: AddNacos, options binding and validation, client lifetime management.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lolitacoding.Nacos\Lolitacoding.Nacos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lolitacoding.Nacos.Tests" />
    <InternalsVisibleTo Include="Lolitacoding.Nacos.IntegrationTests" />
  </ItemGroup>

</Project>
