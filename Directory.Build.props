<Project>

  <PropertyGroup>
    <!-- Target platform: .NET 11 only, with the newest language features. -->
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- .NET 11 runtime async. Async methods compile to resumable calls the runtime drives
         directly instead of a compiler-generated state machine; async iterators still use one.
         The switch is a compiler feature flag, not an SDK property, so it travels in Features. -->
    <Features>$(Features);runtime-async=on</Features>

    <!-- Quality gates. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Every public member must carry XML documentation; the SDK emits CS1591
         for undocumented members, which we enforce selectively instead. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Packaging. -->
    <Authors>Lolitacoding</Authors>
    <Company>Lolitacoding</Company>
    <Product>Lolitacoding.Nacos</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lolitacoding/Lolitacoding.Nacos</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lolitacoding/Lolitacoding.Nacos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>nacos;configuration;service-discovery;grpc;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- MinVer derives the version from git tags; 0.1.0-preview.0 before the first tag. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- Tests and samples: never packed, never documented, no public-API baseline. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('.IntegrationTests')) Or $(MSBuildProjectName.StartsWith('Sample.'))">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnablePublicApiAnalyzers>false</EnablePublicApiAnalyzers>
    <!-- IDE0005 (unnecessary using) can only be reported when a documentation file is
         generated, which is deliberately off for these projects. -->
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Opt-out switch used by the test/sample block above. -->
    <EnablePublicApiAnalyzers Condition="'$(EnablePublicApiAnalyzers)' == ''">true</EnablePublicApiAnalyzers>
    <IsPackable Condition="'$(IsPackable)' == ''">true</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnablePublicApiAnalyzers)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
